# URL of the deployed backend API, without a trailing slash.
VITE_API_URL=https://api.example.com

# Base URL used for public share links. This should point to the backend origin serving /share/:slug.
VITE_SHARE_BASE_URL=https://api.example.com

# Optional public URL for uploaded asset files served from a custom R2 domain.
VITE_R2_PUBLIC_URL=https://cdn.example.com
