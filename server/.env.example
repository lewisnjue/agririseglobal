# Server port
PORT=5000

# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT secret (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
# For production, use the exact frontend origin with no trailing slash.
# CLIENT_URL=https://agririseglobal-wine.vercel.app
# Public server URL used in uploaded image links (optional locally)
SERVER_URL=http://localhost:5000

# Cloudflare R2 S3-compatible storage
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ACCOUNT_ID=
BUCKET_NAME=
# Optional R2 custom domain or public r2.dev URL. Leave empty to use the API proxy.
R2_PUBLIC_URL=

# Optional absolute HTTPS image used when a post has no publicly accessible featured image.
DEFAULT_OG_IMAGE=

