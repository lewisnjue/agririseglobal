{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Mm]eta-external(agent|fetcher)|[Ww]hatsapp|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ss]lackbot|[Tt]elegrambot|[Dd]iscordbot|[Pp]interest|[Gg]ooglebot).*"
        }
      ],
      "destination": "/api/share/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
